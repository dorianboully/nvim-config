# ---------- ;-suffix auto variants (expand instantly, no menu) ----------
# Type the manual trigger then `;` to expand without the completion menu,
# UltiSnips-expand-key style. Math ones are context-gated like the rest.

snippet ttl; "env title (;)" Ai
(title: [$1])
endsnippet

snippet eq; "Equation (;)" Aw
#equation(id: "eq$1")[
	$0
]
endsnippet

snippet def; "Definition (;)" Aw
#definition$1[
	$0
]
endsnippet

snippet rem; "Remark (;)" Aw
#remark$1[
	$0
]
endsnippet

snippet thm; "Theorem (;)" Aw
#theorem$1[
	$0
]
endsnippet

snippet lem; "Lemma (;)" Aw
#lemma$1[
	$0
]
endsnippet

snippet cor; "Corollary (;)" Aw
#corollary$1[
	$0
]
endsnippet

snippet exr; "Exercise (;)" Aw
#exercise$1[
	$0
]
endsnippet

snippet exp; "Example (;)" Aw
#example$1[
	$0
]
endsnippet

snippet prp; "Proposition (;)" Aw
#proposition$1[
	$0
]
endsnippet

snippet prt; "Property (;)" Aw
#property$1[
	$0
]
endsnippet

snippet conj; "Conjecture (;)" Aw
#conjecture$1[
	$0
]
