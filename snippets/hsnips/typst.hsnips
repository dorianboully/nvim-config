# Typst snippets for HyperSnips (VSCode) — curated port of snippets/typst/*.json
# + snippets/typst/math.lua (2026-07-03). Nvim/LuaSnip keeps reading the originals.
#
# Flags: w = word boundary (LuaSnip wordTrig=true parity)
#        i = in-word, matches as a word suffix (LuaSnip wordTrig=false parity)
#        A = automatic expansion (no Tab). Only used where `context math(context)`
#            gates it to real typst math mode (markup.math.typst, verified against
#            tinymist's compiled grammar) or where the trigger is `;`-prefixed and
#            therefore can never collide with a real identifier.
#
# 2026-07-06: most math snippets are now automatic (A) to skip the completion
# menu entirely. Kept MANUAL on purpose (trigger is a prefix of something you
# might actually type, or conflicts with a document macro):
#   set int pr mi ar to do cd not le ge ne ni teq sub sup cap cup ab al mm dm ttl
#   (cd = codimension operator in AlgComm; mi < min/mid/mod; ar < arg/arrow;
#    to < top; do < dots; int < inter/integral; pr < prime/prod; ab < abl;
#    ni < nin; teq < teqq)
# plus everything in markup mode (env snippets, lb, mm/dm).
# Every manual trigger also has an instant `TRIG;` variant (see the ;-suffix
# section at the end of this file): type the trigger then `;` to expand
# without waiting for the completion menu.

global
function math(context) {
  return context.scopes.some((s) => s.startsWith("markup.math.typst"));
}
endglobal

# ---------- suffix operators (ex math.lua) ----------

# jj/kk replace sp/sb (vim reference: j = down = subscript, k = up = superscript)
context math(context)
snippet kk "superscript" Ai
^($1)
endsnippet

context math(context)
snippet jj "subscript" Ai
_($1)
endsnippet

context math(context)
snippet sbp "subscript and superscript" Ai
_($1)^($2) $0
endsnippet

context math(context)
snippet tp "transpose" Ai
^(top)$0
endsnippet

context math(context)
snippet st "star" Ai
^(*)$0
endsnippet

context math(context)
snippet inv "inverse" Ai
^(-1)$0
endsnippet

context math(context)
snippet ort "orthogonal (perp)" Ai
^(perp)$0
endsnippet

snippet ttl "env title" i
(title: [$1])
endsnippet

# ---------- environments (ex env.json) ----------

snippet eq "Equation" w
#equation(id: "eq$1")[
	$0
]
endsnippet

snippet def "Definition" w
#definition$1[
	$0
]
endsnippet

snippet rem "Remark" w
